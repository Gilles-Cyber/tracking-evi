# Copy this file to .env.local and fill in your real values.

# Supabase (required by src/lib/supabase.ts)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Optional for AI features if/when used in the app
GEMINI_API_KEY="your-gemini-api-key"

# Resend email (server-side)
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="Evri <no-reply@yourdomain.com>"
RESEND_TO_EMAIL="support@yourdomain.com"

# Tawk.to live chat (client-side)
VITE_TAWK_PROPERTY_ID="your-tawk-property-id"
VITE_TAWK_WIDGET_ID="your-tawk-widget-id"
